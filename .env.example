# ===== LLM Provider =====
# mock    — in-process fake model (no API key needed)
# minimax — MiniMax API (real, needs key) — OpenAI-compatible
# openai  — OpenAI / any OpenAI-compatible provider (just set MINIMAX_BASE_URL)
LLM_PROVIDER=mock

# MiniMax config (Anthropic-compatible endpoint + OpenAI-compatible endpoint)
# OpenAI-compatible: https://api.minimaxi.com/v1
# Anthropic-compatible: https://api.minimaxi.com/anthropic
MINIMAX_API_KEY=your_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# ===== Server =====
NODE_ENV=development
SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# ===== Database (MySQL) =====
# Format: mysql://<user>:<password>@<host>:<port>/<database>
# Default matches the docker-compose.yml in this repo.
DATABASE_URL=mysql://myagent:myagent@localhost:3306/my_agent

# ===== Sandbox =====
SANDBOX_WORKDIR=./sandbox-workdir
SANDBOX_TIMEOUT_MS=30000

# ===== Logging =====
LOG_LEVEL=info
LOG_DIR=./logs
